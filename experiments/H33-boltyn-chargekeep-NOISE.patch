diff --git a/test/chargekeep.test.js b/test/chargekeep.test.js
new file mode 100644
index 0000000..35eeb3a
--- /dev/null
+++ b/test/chargekeep.test.js
@@ -0,0 +1,66 @@
+/* ============================================================
+   SPXCHARGEKEEP: THE CARD THAT CASHES THE CHARGE IS NOT THE ONE CHARGED
+
+   Valiant Thrust (pinned): "If you've charged this turn, this gets +3{p}."
+   Courageous Steelhand: "If you've charged this turn, target attack gets
+   +3{p}." Neither offers a charge of its own, so only another card's charge
+   ever pays them off. The first charge pick ranked lowest pitch first and put
+   the red ones into the soul: 48 of 453 first charges at 3 seeds, 32 with a
+   plain card beside them. `judge.ridesCharge` names them and they go last.
+   The fixture is a real Boltyn self-play state where the call is
+   `chargeKeep`. Observables: the charged card is a plain one, and the rider
+   is still in hand after the charge. Refusal half: the reader answers false
+   for a card that offers its own charge (Take Flight) and for a plain attack
+   (Snatch).
+   Sabotage checked: `ride` always 0 fails the first test (no `chargeKeep`).
+   ============================================================ */
+const test = require("node:test");
+const assert = require("node:assert/strict");
+const SPL = require("../tools/selfplay.js");
+const J = SPL.J, SP = SPL.SP;
+
+function find(hero, hit, games){
+  const foes = SPL.W.HEROES.map(h => h.k).filter(k => k !== hero);
+  for(let gi = 0; gi < (games || 48); gi++){
+    const seat = gi % 2, foe = foes[gi % foes.length];
+    let n = SPL.match(seat ? foe : hero, seat ? hero : foe, "chargekeep-" + gi, gi % 2);
+    for(let i = 0; i < 3000 && !n.over; i++){
+      let moved = false;
+      for(const s of [0, 1]){
+        const e = SP.explain(n, s); if(!e || !e.action) continue;
+        if(s === seat && hit(n, seat, e)) return {n, seat, e};
+        const o = J.reduce(n, e.action, s); if(o.error) continue;
+        n = o.state; moved = true; break;
+      }
+      if(!moved) break;
+    }
+  }
+  return null;
+}
+const F = find("boltyn", (n, s, e) => e.key === "chargeKeep");
+
+test("SPXCHARGEKEEP: a plain card is charged and the rider stays in hand", () => {
+  assert.ok(F, "found in self-play");
+  const {n, seat, e} = F;
+  const sd = n.sides[seat];
+  assert.equal(n.pending && n.pending.kind, "charge");
+  const offer = sd.hand.filter(h => (n.pending.uids || []).indexOf(h.uid) >= 0);
+  const riders = offer.filter(h => J.ridesCharge(n, seat, h.uid));
+  assert.ok(riders.length, "a rider was on offer");
+  assert.equal(e.action.t, "charge");
+  assert.equal(J.ridesCharge(n, seat, e.action.uid), false, "the charged card is plain");
+  const o = J.reduce(n, e.action, seat); assert.equal(o.error, null);
+  const hand = o.state.sides[seat].hand.map(h => h.uid);
+  for(const r of riders) assert.ok(hand.indexOf(r.uid) >= 0, r.name + " is still in hand");
+});
+
+test("SPXCHARGEKEEP: the reader names only cards another card's charge pays off", () => {
+  const g = SPL.match("boltyn", "briar", "chargekeep-reader", 0);
+  const sd = g.sides[0];
+  const pick = name => { const c = sd.deck.find(x => x && x.name === name); sd.hand.push(c); return c.uid; };
+  assert.equal(J.ridesCharge(g, 0, pick("Valiant Thrust")), true);
+  assert.equal(J.ridesCharge(g, 0, pick("Courageous Steelhand")), true);
+  assert.equal(J.ridesCharge(g, 0, pick("Take Flight")), false, "it offers its own charge");
+  assert.equal(J.ridesCharge(g, 0, pick("Snatch")), false, "no charge rider");
+  assert.equal(J.ridesCharge(g, 0, 99999), false, "an unknown uid answers false");
+});
