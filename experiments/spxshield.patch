diff --git a/test/misplays.test.js b/test/misplays.test.js
index 868e0ea..bee508d 100644
--- a/test/misplays.test.js
+++ b/test/misplays.test.js
@@ -176,3 +176,46 @@ test("Scout the Periphery's look goes where it adds information: their deck, unl
   assert.equal(J.lookChoice(other, 0), null);
   assert.equal(SP.explain(other, 0).key, "firstOption");
 });
+
+/* ---- TRAINER QA CENSUS (Fai, Enigma, Arakni, Blaze, Gravy, Lyath): the hero's shield ---- */
+
+test("an attack aimed at an ally is not the hero's to prevent: Throw Caution is held — and cast when the hero is the target", {skip}, () => {
+  const {match} = SPP();
+  /* replayed, one action per step, to the first reaction window where Gravy defends an
+     attack on his ally holding a castable Throw Caution (found by the census probe) */
+  let n = match("gravy", "kayo", "ally-kayo-1", 0), steps = 0, at = null;
+  while(!n.over && steps < 4000 && !at){
+    let moved = false;
+    for(const seat of [0, 1]){
+      if(seat === 0 && n.pend && n.pend.by === 1 && n.step === "reaction" && J.linkAtAlly(n)){
+        const tc = n.sides[0].hand.find(c => /Throw Caution/.test(c.name));
+        if(tc && J.legal(n, {t: "play", uid: tc.uid, from: "hand"}, 0) == null){ at = {n, tc}; break; }
+      }
+      const a = SP.act(n, seat); if(!a) continue;
+      const r = J.reduce(n, a, seat); if(r.error) continue;
+      n = r.state; steps++; moved = true; break;
+    }
+    if(!moved) break;
+  }
+  assert.ok(at, "the fixture game reaches the window");
+  const e = SP.explain(at.n, 0);
+  assert.deepEqual(e.action, {t: "pass"}, "the card protects the hero, and the hero is not the target");
+  assert.equal(e.key, "rxAllyHold");
+  /* the same window with the attack on the hero: the reader flips and the hold does not fire */
+  const atHero = {...at.n, pend: {...at.n.pend, target: {kind: "hero", side: 0, uid: null}}};
+  assert.equal(J.linkAtAlly(atHero), false);
+  assert.notEqual(SP.explain(atHero, 0).key, "rxAllyHold");
+});
+
+test("a 'this turn' shield for yourself lands nothing on your own turn — and is a shield on theirs", {skip}, () => {
+  const {match} = SPP();
+  let g = match("gravy", "kayo", "mp-tc", 0);
+  const tc = g.sides[0].hand.concat(g.sides[0].deck).find(c => /Throw Caution/.test(c.name));
+  g = side(g, 0, {hand: [tc], arsenal: null, res: 3});
+  assert.equal(g.turnPlayer, 0, "Gravy's own action phase");
+  assert.equal(J.landsNothing(g, 0, tc.uid, "hand", {ownTurnShield: true}), true, "no opponent attack can come before the window closes");
+  assert.equal(J.landsNothing(g, 0, tc.uid, "hand"), false, "without the ask the reader stays as it was");
+  assert.equal(J.landsNothing({...g, turnPlayer: 1}, 0, tc.uid, "hand", {ownTurnShield: true}), false, "on their turn it is a real shield");
+  const a = SP.act(g, 0);
+  assert.ok(!(a && a.t === "play" && a.uid === tc.uid), "it is not cast as a filler: " + JSON.stringify(a));
+});
