diff --git a/experiments/H31-ally-ab.js b/experiments/H31-ally-ab.js
new file mode 100644
index 0000000..5579d55
--- /dev/null
+++ b/experiments/H31-ally-ab.js
@@ -0,0 +1,33 @@
+/* H31 (HELD): own-seat A/B for the free-ally-first rule, paired by seed.
+     node experiments/H31-ally-ab.js [hero=gravy] [seeds=40] [prefix=A] [opponents,comma]
+   The hero sits in seat 0 against every other hero, `first: s % 2`, seed string `<prefix><hero>-<opp>-<s>`;
+   the rule is switched on for the hero's seat only (`SP.SPX31`), so the opponents play as shipped.
+   Prints wins per seed (of the opponents played) for off and on, and the paired difference. */
+const S = require("../tools/selfplay.js");
+const {match, play, W, SP} = S;
+const hero = process.argv[2] || "gravy", N = +(process.argv[3] || 40), prefix = process.argv[4] || "A";
+const opps = (process.argv[5] ? process.argv[5].split(",") : W.HEROES.map(h => h.k)).filter(k => k !== hero);
+function run(on){
+  SP.SPX31.length = 0; if(on) SP.SPX31.push(hero);
+  const by = [], bad = {err: 0, viol: 0, stall: 0, draw: 0};
+  for(let s = 0; s < N; s++){
+    let w = 0;
+    for(const o of opps){
+      const r = play(match(hero, o, `${prefix}${hero}-${o}-${s}`, s % 2));
+      bad.err += r.errs.length; bad.viol += r.viols.length;
+      if(!r.game.over) bad.stall++;
+      else if(r.game.over.winner == null) bad.draw++;
+      else if(r.game.over.winner === 0) w++;
+    }
+    by.push(w);
+  }
+  SP.SPX31.length = 0;
+  return {by, bad};
+}
+const mean = a => a.reduce((x, y) => x + y, 0) / a.length;
+const off = run(false), on = run(true);
+const d = on.by.map((x, i) => x - off.by[i]);
+const md = mean(d), sd = Math.sqrt(mean(d.map(x => (x - md) ** 2)) * d.length / Math.max(1, d.length - 1));
+console.log(`${hero} ${prefix} off [${off.by}] mean ${mean(off.by).toFixed(2)} bad ${JSON.stringify(off.bad)}`);
+console.log(`${hero} ${prefix} on  [${on.by}] mean ${mean(on.by).toFixed(2)} bad ${JSON.stringify(on.bad)}`);
+console.log(`paired ${md >= 0 ? "+" : ""}${md.toFixed(2)} (t ${(sd ? md / (sd / Math.sqrt(d.length)) : 0).toFixed(1)}, ${d.filter(x => x > 0).length} up / ${d.filter(x => x < 0).length} down)`);
diff --git a/test/allydecoy.test.js b/test/allydecoy.test.js
new file mode 100644
index 0000000..0a9eb37
--- /dev/null
+++ b/test/allydecoy.test.js
@@ -0,0 +1,82 @@
+/* ============================================================
+   A FREE ALLY GOES OUT FIRST WHEN THE ARENA HOLDS NONE (QUEUE H31 — HELD).
+   Gravy Bones' allies die unswung (196 of 198 deploys in 30 traced games spent the turn's last
+   action point, and 174 never swung): the opponent's policy takes any ally it can kill, and an
+   attack on an ally cannot be blocked (CR 7.3.2a). A deploy is a decoy, and a decoy soaks nothing
+   while the arena holds one already. The rule is GATED (`SPX31`), so these drills switch it on
+   for the one seat and the control member of every pair is the same hand with it off.
+
+   Every drill is a fire / don't-fire pair: ONE fact moves between the two members (the gate, the
+   board, the printed cost, a go-again attack in hand).
+   ============================================================ */
+const test = require("node:test");
+const assert = require("node:assert/strict");
+const SP = require("../engine/sparring.js");
+const H = require("./helpers/judged.js");
+const J = H.J;
+
+const skip = !H.hasDb() && "no cached card database";
+const ent = (n, p, uid, over) => Object.assign({}, H.card(n, p), {uid}, over || {});
+const probe = (uid, power) => ({uid, name: "Probe " + uid, pitch: 1, power, def: 2, cost: 0,
+  tt: "Generic Action - Attack", ty: ["Generic", "Action", "Attack"], tx: "", kw: []});
+const table = (hand, o) => {
+  o = o || {};
+  const g = H.state({name: "Gravy", res: o.res || 0, ap: 1, hand, deck: [probe("d1", 1)], board: o.board || []},
+    {hp: 20, hand: [], deck: [probe("t1", 1)]}, {actor: 0, turnPlayer: 0, turn: 3, builds: [{}, {}]});
+  g.sides[0].heroKey = "gravy";
+  return Object.assign(g, {phase: "action", step: "layer", priority: 0, passed: []});
+};
+const gated = fn => { SP.SPX31.push("gravy"); try { return fn(); } finally { SP.SPX31.length = 0; } };
+const isPlay = (a, uid) => !!a && a.t === "play" && a.uid === uid;
+const ally = uid => { const c = ent("Swabbie", 2, uid); return {card: c, kind: "ally", uid, spent: false, life: 3}; };
+
+test("H31: a free ally goes out before a bigger hand attack when the arena holds none", {skip}, () => {
+  const hand = () => [ent("Oysten, Heart of Gold", 2, "oy"), probe("big", 7)];
+  const off = SP.explain(table(hand()), 0);
+  assert.ok(isPlay(off.action, "big"), "control, gate off: the bigger swing wins the point: " + JSON.stringify(off.action));
+  assert.equal(J.legal(table(hand()), {t: "play", uid: "oy", from: "hand"}, 0), null, "control: the deploy is legal");
+  gated(() => {
+    const g = table(hand());
+    const x = SP.explain(g, 0);
+    assert.ok(isPlay(x.action, "oy"), "deploys first: " + JSON.stringify(x.action));
+    assert.equal(x.key, "allyDecoy", "under its own reason");
+    assert.ok(SP.CALL_WHY.allyDecoy, "and the reason is worded");
+    assert.deepEqual(x.action, SP.act(g, 0), "explain is act plus the reason");
+    assert.equal(J.allyDeploy(g, 0, "oy", "hand"), true);
+    assert.equal(J.allyDeploy(g, 0, "big", "hand"), false, "a swing is not a deploy");
+  });
+});
+
+test("H31: with an ally already in the arena the deploy is not pulled forward", {skip}, () => {
+  gated(() => {
+    const g = table([ent("Oysten, Heart of Gold", 2, "oy"), probe("big", 7)], {board: [ally("sw")]});
+    const x = SP.explain(g, 0);
+    assert.notEqual(x.key, "allyDecoy", "the arena already holds a decoy: " + JSON.stringify(x));
+    assert.ok(!isPlay(x.action, "oy"), "the free ally waits: " + JSON.stringify(x.action));
+  });
+});
+
+test("H31: an ally that costs a card is not pulled forward", {skip}, () => {
+  gated(() => {
+    const g = table([ent("Oysten, Heart of Gold", 2, "oy", {cost: 1}), probe("big", 7)], {res: 1});
+    assert.equal(J.legal(g, {t: "play", uid: "oy", from: "hand"}, 0), null, "control: it is affordable");
+    const x = SP.explain(g, 0);
+    assert.notEqual(x.key, "allyDecoy", JSON.stringify(x));
+    assert.ok(isPlay(x.action, "big"), "the swing keeps the point: " + JSON.stringify(x.action));
+  });
+});
+
+test("H31: a go-again attack still goes before the free ally", {skip}, () => {
+  gated(() => {
+    const g = table([ent("Oysten, Heart of Gold", 2, "oy"), ent("Saltwater Swell", 3, "sw")], {res: 1});
+    const x = SP.explain(g, 0);
+    assert.ok(isPlay(x.action, "sw"), "the attack that keeps the point leads: " + JSON.stringify(x.action));
+    assert.equal(x.key, "atkKeepsAP");
+  });
+});
+
+test("H31: the rule is off unless the seat's hero is named", {skip}, () => {
+  const g = table([ent("Oysten, Heart of Gold", 2, "oy"), probe("big", 7)]);
+  g.sides[0].heroKey = "kayo";
+  gated(() => assert.ok(isPlay(SP.act(g, 0), "big"), "another hero's seat plays as before"));
+});
