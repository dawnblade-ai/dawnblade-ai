+/* ---- WOULD THIS ATTACK, MADE NOW, KEEP THE ACTION POINT? (H4) --------
+
+   `keepsActionPoint`'s sibling, for `sparring.js`, which reads no card
+   text. It answers for an ATTACK the seat could make right now, from hand,
+   arsenal or an attacking board entry, with the same three sources of go
+   again `execute` collects at the attack's declaration:
+
+     the card's own UNCONDITIONAL go again — `fx.ga`, except where it sits
+       on an activated ability's line (`abilityGa`: an ally's attack line
+       is not its play, and `execute` grants the deploy nothing), or, for
+       a board ally's attack, `allyAttack(...).ga`, its attack line's;
+     a bare waiting `gaNext`, which the next attack takes whatever it is;
+     a qualified `gaNextQ` entry the attack matches (`qualMatches`, the
+       one matcher `takeGaNext` uses, with the route as the caller's
+       answer).
+
+   A card whose play puts it in the arena (an ally deploy) is not an
+   attack and answers false, as does anything the seat does not hold. A
+   conditional go again (High Tide) is deliberately not counted. */
+const attackKeepsActionPoint = (g, seat, uid, from) => {
+  const sd = at(g, seat);
+  let c = null, route = from;
+  if(from === "board"){
+    const b = (sd.board || []).find(x => x && x.uid === uid);
+    const aa = b && PR.allyAttack(b.card);
+    if(!aa) return false;
+    c = b.card; route = "ally";
+    if(aa.ga) return true;
+  } else {
+    c = from === "arsenal" ? (sd.arsenal && sd.arsenal.uid === uid ? sd.arsenal : null)
+      : from === "hand" ? (sd.hand || []).find(x => x && x.uid === uid) : null;
+    if(!c || !TY.isAttack(c) || TY.destination(c) === "arena") return false;
+    if(!PR.abilityGa(c) && PR.fxParse(c).ga === true) return true;
+    if(c._arsGA && c._upTurn === g.turn) return true;
+  }
+  if(sd.gaNext) return true;
+  const qc = {from: route, atk: true};
+  return (sd.gaNextQ || []).some(x => x && x.q && PR.qualMatches(x.q, c, qc));
+};
+/* ---- WHICH ATTACKS COULD TAKE THIS GRANT THIS TURN? (H4) -------------
+
+   `keepsActionPoint`'s sibling, for `sparring.js`, which reads no card
+   text. A non-attack whose WHOLE payload is a next-attack grant — the
+   `buffNext` / `gaNext` ops, each with its printed qualifier ("your next
+   Pirate ally attack this turn gets go again") — does nothing unless an
+   attack the qualifier admits follows it this turn.
+
+   Answers `null` for a card that is not such a pure grant (it prints
+   anything else, or a condition): this reader only speaks about a grant.
+   Otherwise the list of attacks LEGAL RIGHT NOW that the grant's
+   qualifier admits — an attack card from hand or arsenal (never the
+   grant itself), an attacking board entry, a weapon swing — each as
+   `{uid, from, cost}` with the printed cost, so the caller can ask its
+   own affordability question. Matched through `qualMatches`, the one
+   matcher `execute` spends the grant with, route as the caller's answer. */
+const GRANT_Q = {buffNext: 2, gaNext: 1};
+const grantTakers = (g, seat, uid, from) => {
+  const sd = at(g, seat);
+  const c = from === "arsenal" ? (sd.arsenal && sd.arsenal.uid === uid ? sd.arsenal : null)
+          : from === "hand" ? (sd.hand || []).find(x => x && x.uid === uid) : null;
+  if(!c) return null;
+  const fx = PR.fxParse(c);
+  const ops = (fx.ops || []).filter(o => o && o[0] !== "noop");
+  if(!ops.length || (fx.conds || []).length || fx.optCost) return null;
+  if(!ops.every(o => GRANT_Q[o[0]] != null)) return null;
+  const qs = ops.map(o => o[GRANT_Q[o[0]]] || null);
+  const takes = (card, route) => qs.some(q => !q || PR.qualMatches(q, card, {from: route, atk: true}));
+  const out = [];
+  const cards = (sd.hand || []).map(h => ({h, f: "hand"}))
+    .concat(sd.arsenal ? [{h: sd.arsenal, f: "arsenal"}] : []);
+  for(const {h, f} of cards)
+    if(h && h.uid !== uid && TY.isAttack(h) && takes(h, f)
+       && legal(g, {t: "play", uid: h.uid, from: f, target: "hero"}, seat) == null)
+      out.push({uid: h.uid, from: f, cost: +h.cost || 0});
+  for(const b of sd.board || []){
+    const ba = b && boardAttackOf(g, seat, b.uid);
+    if(ba && takes(b.card, ba.kind)
+       && legal(g, {t: "activate", uid: b.uid, target: "hero"}, seat) == null)
+      out.push({uid: b.uid, from: "board", cost: ba.cost || 0});
+  }
+  for(const w of sd.gear || [])
+    if(w && PR.isWeapon(w) && takes(w, "weapon")
+       && legal(g, {t: "activate", uid: w.uid}, seat) == null)
+      out.push({uid: w.uid, from: "weapon", cost: +w.cost || 0});
+  return out;
+};
 const targetOf = (g, seat, spec) => {
