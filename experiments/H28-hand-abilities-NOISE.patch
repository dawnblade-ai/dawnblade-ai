+/* H28 own-seat paired A/B driver (EXPERIMENT, not shipped). HX="<hero>:<variant>" gates the env-only hooks in sparring.js. ab.js <hero> <s0> <s1> [variant,...]  — hero (seat a) vs each of the other 14 heroes at seeds s0..s1-1, old (HX unset) against new, paired by seed. */
+const {spawnSync, spawn} = require("child_process");
+const R = require("path").join(__dirname, "..") + "/";
+if(process.argv[2] === "--child"){
+  const {match, play, W} = require(R + "tools/selfplay.js");
+  const hero = process.argv[3], s0 = +process.argv[4], s1 = +process.argv[5];
+  const out = [];
+  let bad = {ref: 0, viol: 0, stall: 0, draw: 0};
+  for(let s = s0; s < s1; s++){
+    let w = 0;
+    for(const h of W.HEROES){
+      if(h.k === hero) continue;
+      const r = play(match(hero, h.k, `${hero}-${h.k}-${s}`, s % 2));
+      if(!r.game.over) bad.stall++;
+      else if(r.game.over.winner == null) bad.draw++;
+      else if(r.game.over.winner === 0) w++;
+      bad.ref += r.errs.length; bad.viol += r.viols.length;
+    }
+    out.push(w);
+  }
+  console.log(JSON.stringify({out, bad}));
+  process.exit(0);
+}
+const [hero, s0, s1, variants] = [process.argv[2], +process.argv[3], +process.argv[4], process.argv[5] || ""];
+const hx = variants.split(",").filter(Boolean).map(v => hero + ":" + v).join(",");
+const run = env => new Promise(res => {
+  const p = spawn("node", [__filename, "--child", hero, s0, s1], {env: Object.assign({}, process.env, {HX: env})});
+  let o = ""; p.stdout.on("data", d => o += d); p.stderr.on("data", d => o += d);
+  p.on("close", () => { try { res(JSON.parse(o.trim().split("\n").pop())); } catch(e){ res({err: o.slice(-300)}); } });
+});
+Promise.all([run(""), run(hx)]).then(([a, b]) => {
+  if(!a.out || !b.out){ console.log("ERR", JSON.stringify(a).slice(0, 300), JSON.stringify(b).slice(0, 300)); return; }
+  const d = a.out.map((x, i) => b.out[i] - x);
+  const n = d.length, m = d.reduce((x, y) => x + y, 0) / n;
+  const sd = Math.sqrt(d.reduce((x, y) => x + (y - m) * (y - m), 0) / (n - 1)) || 1e-9;
+  const mean = v => (v.reduce((x, y) => x + y, 0) / v.length).toFixed(2);
+  console.log(`${hero} [${variants}] seeds ${s0}-${s1 - 1}: old ${mean(a.out)} -> new ${mean(b.out)} /14  paired ${m.toFixed(2)} t ${(m / (sd / Math.sqrt(n))).toFixed(1)}  up ${d.filter(x => x > 0).length} down ${d.filter(x => x < 0).length} level ${d.filter(x => x === 0).length}  bad(new) ${JSON.stringify(b.bad)}`);
+});
