diff --git a/test/wasteblock.test.js b/test/wasteblock.test.js
new file mode 100644
index 0000000..3ccf2d3
--- /dev/null
+++ b/test/wasteblock.test.js
@@ -0,0 +1,121 @@
+/* ============================================================
+   A SEAT THAT THROWS RESOURCES AWAY HAS CARDS TO SPARE (QUEUE v5 H30)
+   `takeUpTo` takes a hit of 3 or less to the face and keeps the card, which
+   presumes the card is worth something next turn. Gravy Bones fizzles 0.85
+   resources a turn (Dash 0.28, Arakni 0.09): his pitch outruns what he plays,
+   so the last card pitched bought nothing, and the same card stopping a
+   3-point hit buys 2 or 3 life. `judge.wastePerTurn` reads the engine's own
+   `wasted` tally (CR 4.4.3e) over the seat's own turns; at `wasteLine`
+   (0.5) the line drops by one. Measured on Gravy's own seat, 14 opponents,
+   paired by seed: set 0-11 3.75 -> 4.83 (t 3.5, 9 up 1 down), set 12-23
+   4.83 -> 5.25, set 24-47 3.46 -> 3.83 (t 1.9, 11 up 5 down).
+
+   Driven on a real defend step, asserted on the action chosen, the reason
+   key, and that `explain` returns the very action `act` does.
+   ============================================================ */
+const test = require("node:test");
+const assert = require("node:assert/strict");
+const SP = require("../engine/sparring.js");
+const P = require("../engine/priority.js");
+const H = require("./helpers/judged.js");
+const J = H.J;
+
+const skip = !H.hasDb() && "no cached card database";
+const wall = (uid, def) => ({uid, name: "Wall " + uid, pitch: 3, cost: 0, power: null, def,
+  tt: "Generic Action", ty: ["Generic", "Action"], kw: [], tx: ""});
+const hand = (n, def) => Array.from({length: n}, (_, i) => wall("h" + (i + 1), def == null ? 3 : def));
+/* seat 1 defends a swing of `total` with `cards` in hand, on game turn `turn`, having fizzled `wasted` */
+function defend(cards, total, wasted, turn, extra){
+  const g = H.state({name: "Atk", res: 0, ap: 0, hand: [], deck: [wall("a1", 1)]},
+    Object.assign({name: "Def", hp: 20, hand: cards, deck: [wall("d1", 1)], wasted}, extra || {}),
+    {actor: 0, turnPlayer: 0, turn: turn == null ? 8 : turn});
+  return Object.assign({}, g, {phase: "action", step: "defend", attacker: 0, priority: 0, chainOpen: true, passed: [],
+    pend: {name: "Pinprick", by: 0, total, target: {kind: "hero", side: 1, uid: null}}});
+}
+const said = g => SP.explain(g, 1);
+
+test("H30: the reader is the seat's fizzle per turn of its own, and silent before two turns", {skip}, () => {
+  assert.equal(J.wastePerTurn(defend(hand(3), 3, 8, 8), 1), 2, "8 fizzled over 4 own turns");
+  assert.equal(J.wastePerTurn(defend(hand(3), 3, 8, 8), 0), 0, "the other seat fizzled nothing");
+  assert.equal(J.wastePerTurn(defend(hand(3), 3, 8, 3), 1), 0, "one own turn says nothing yet");
+  assert.equal(J.wastePerTurn(defend(hand(3), 3, undefined, 8), 1), 0, "no tally is zero, not NaN");
+});
+
+test("H30: a seat that fizzles blocks a 3-point hit with a card from a hand of three", {skip}, () => {
+  const g = defend(hand(3), 3, 8);
+  assert.ok(P.canDeclareDefenders(g, 1), "control: seat 1 may declare defenders");
+  const x = said(g);
+  assert.equal(x.action && x.action.t, "defend", "blocked: " + JSON.stringify(x.action));
+  assert.equal(x.key, "blockWaste", "under its own reason");
+  assert.ok(SP.CALL_WHY.blockWaste && x.why === SP.CALL_WHY.blockWaste, "and the call says why");
+  assert.deepEqual(x.action, SP.act(g, 1), "explain returns the action act proposes");
+  assert.equal(J.legal(g, x.action, 1), null, "the judge accepts it");
+});
+
+test("H30: the same hand and hit with nothing fizzled takes the hit (control)", {skip}, () => {
+  const g = defend(hand(3), 3, 0);
+  assert.equal(SP.act(g, 1), null, "a hand of three with a use next turn is not spent on 3 damage");
+  assert.equal(said(g).action, null);
+});
+
+test("H30: too early in the game to say, the line is not moved", {skip}, () => {
+  const g = defend(hand(3), 3, 8, 3);
+  assert.equal(SP.act(g, 1), null, "one own turn of fizzle is not a pattern");
+});
+
+test("H30: a smaller hit is still taken, and a bigger one keeps blockHand", {skip}, () => {
+  assert.equal(SP.act(defend(hand(3), 2, 8), 1), null, "2 damage is under the lowered line too");
+  assert.equal(said(defend(hand(3), 7, 8)).key, "blockHand", "a 7-point hit is too big to take, whoever fizzles");
+});
+
+test("H30: the line is the option, not a number written twice", {skip}, () => {
+  const g = defend(hand(3), 3, 4);   /* 1.0 a turn */
+  assert.ok(SP.nextBlocker(g, 1, {...SP.DEFAULTS, wasteLine: 0.9}), "1.0 clears a line of 0.9");
+  assert.equal(SP.nextBlocker(g, 1, {...SP.DEFAULTS, wasteLine: 1.1}), null, "and does not clear 1.1");
+  assert.equal(SP.DEFAULTS.wasteLine, 0.5);
+});
+
+test("H30: a card that stops part of the hit is spent, under the same reason", {skip}, () => {
+  /* the leak is 3, the best card stops 2 and the hit still lands for 1: measured, this is the
+     half of the rule that moves Gravy (the whole-stop version alone gained a third as much) */
+  const g = defend(hand(3, 2), 3, 8);
+  const x = said(g);
+  assert.equal(x.action && x.action.t, "defend");
+  assert.equal(x.key, "blockWaste");
+  /* a card with no defence at all cannot block, and that is no refusal */
+  assert.equal(SP.act(defend(hand(3, 0), 3, 8), 1), null);
+});
+
+test("H30: a seat that does not fizzle keeps blockSpare, and a spare hand keeps its own reason", {skip}, () => {
+  assert.equal(said(defend(hand(4), 2, 0)).key, "blockSpare", "H21 is unchanged for a seat that fizzles nothing");
+  assert.equal(said(defend(hand(4), 2, 8)).key, "blockSpare", "a hit under the lowered line is H21's, not H30's");
+});
+
+test("H30: lethal is still blocked with everything, under its own reason", {skip}, () => {
+  const g = defend(hand(3), 3, 8, 8, {hp: 3});
+  const x = said(g);
+  assert.equal(x.key, "blockLethal");
+  assert.deepEqual(x.action, SP.act(g, 1));
+});
+
+test("H30: self-play fires it, and the judge never refuses it", {skip}, () => {
+  const {match} = require("../tools/selfplay.js");
+  let fired = 0, refused = 0;
+  for(const [a, b, seed] of [["gravy", "viserai", "gravy-viserai-0"], ["gravy", "dash", "gravy-dash-0"]]){
+    let g = match(a, b, seed, 0);
+    for(let i = 0; i < 1500 && !g.over; i++){
+      let moved = false;
+      for(const s of [0, 1]){
+        const x = SP.explain(g, s);
+        if(!x.action) continue;
+        if(x.key === "blockWaste") fired++;
+        const r = J.reduce(g, x.action, s);
+        if(r.error){ refused++; continue; }
+        g = r.state; moved = true;
+      }
+      if(!moved) break;
+    }
+  }
+  assert.equal(refused, 0, "the judge refused a proposal");
+  assert.ok(fired > 0, "no waste block in two whole games");
+});
