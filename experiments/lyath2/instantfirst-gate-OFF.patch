+    .sort((a, b) => String(a.c.uid) < String(b.c.uid) ? -1 : 1)
+    .forEach(x => {
+      const out = reduce(g, {t: "play", uid: x.c.uid, from: x.from}, seat);
+      if(out.error) return;
+      const st = out.state;
+      if(pendingOf(st) || st.prompt || (st.stack || []).length) return;
+      const gain = best(st, x.c.uid) - best(g, x.c.uid);
+      if(gain >= 1 && (!top || gain > top.gain)) top = {uid: x.c.uid, from: x.from, gain};
+    });
