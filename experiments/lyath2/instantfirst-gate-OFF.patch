diff --git a/test/instantfirst.test.js b/test/instantfirst.test.js
new file mode 100644
index 0000000..a72a954
--- /dev/null
+++ b/test/instantfirst.test.js
@@ -0,0 +1,153 @@
+/* ============================================================
+   A FREE INSTANT THAT MAKES AN ATTACK HIT HARDER GOES BEFORE IT (instantfirst)
+
+   `judge.instantFirst(g, seat, atks, fits)` plays each free Instant-typed non-attack in hand
+   on a COPY of the state and asks `effPowerNow` what the attacks the seat could still pay
+   for would be, before and after. Concealed Object ("the crowd boos you" when it enters)
+   turns Mocking Blow's printed 1 into 5. The policy gate SPXINSTFIRST is OFF unless named.
+
+   Each drill asks for the number that moved AND for the refusal: the crowd already booed
+   (nothing moves), an attack that does not care (nothing moves), an attack the seat could
+   not pay for without the instant, an instant that costs something, a reader that writes.
+   Sabotages applied once each, by hand, and restored (see the commit message).
+   ============================================================ */
+const test = require("node:test");
+const assert = require("node:assert/strict");
+
+const H = require("./helpers/judged.js");
+const skip = !H.hasDb() && "no cached card database";
+const SPP = () => require("../tools/selfplay.js");
+const J = H.J;
+
+const side = (g, i, o) => ({...g, sides: g.sides.map((s, k) => k === i ? {...s, ...o} : s)});
+function find(name){
+  const {match, W} = SPP();
+  for(const h of W.HEROES){
+    const g = match(h.k, h.k === "kayo" ? "dash" : "kayo", "if-" + name, 0);
+    const c = g.sides[0].deck.find(x => x.name === name);
+    if(c) return {g, c};
+  }
+  throw new Error("no deck holds " + name);
+}
+const atkOf = (c, from) => ({uid: c.uid, from: from || "hand"});
+const yes = () => true;
+const setup = (hist) => {
+  const {g, c: co} = find("Concealed Object");
+  const {c: mb} = find("Mocking Blow");
+  const {c: alt} = find("Walk in My Shoes");
+  const st = side(g, 0, {hand: [co, mb], arsenal: null, res: 0, ap: 1, hist: {...g.sides[0].hist, ...(hist || {})}});
+  return {g, co, mb, alt, st};
+};
+
+test("the instant that makes the crowd boo is chosen, with the gain it buys", {skip}, () => {
+  const {co, mb, st} = setup();
+  const printed = require("../engine/parser.js").fxParse(mb).conds.find(e => e.cond === "booed").op[1];
+  const k = J.instantFirst(st, 0, [atkOf(mb)], yes);
+  assert.ok(k, "Concealed Object is worth playing first");
+  assert.equal(k.uid, co.uid);
+  assert.equal(k.from, "hand");
+  assert.equal(k.gain, printed, "the gain is Mocking Blow's own boo bonus");
+});
+
+test("the crowd has already booed: nothing moves, so nothing is chosen", {skip}, () => {
+  const {mb, st} = setup({booed: 1});
+  assert.equal(J.instantFirst(st, 0, [atkOf(mb)], yes), null);
+});
+
+test("an attack that does not care what the crowd did: nothing is chosen", {skip}, () => {
+  const {g, co, alt} = setup();
+  const st = side(g, 0, {hand: [co, alt], arsenal: null, res: 0, ap: 1});
+  assert.equal(J.instantFirst(st, 0, [atkOf(alt)], yes), null);
+});
+
+test("an attack the seat could not pay for without the instant is not counted", {skip}, () => {
+  const {co, mb, st} = setup();
+  assert.equal(J.instantFirst(st, 0, [atkOf(mb)], () => false), null, "no payable attack: no gain");
+  assert.equal(J.instantFirst(st, 0, [], yes), null, "no attack at all");
+  const seen = [];
+  J.instantFirst(st, 0, [atkOf(mb)], (uid, except) => { seen.push([uid, except]); return true; });
+  assert.ok(seen.some(([u, e]) => u === mb.uid && e === co.uid), "affordability is asked with the instant set aside");
+});
+
+test("an instant that costs something is not tried", {skip}, () => {
+  const {g, mb} = setup();
+  const {c: ta} = find("Tension in the Air");
+  assert.ok(+ta.cost > 0, "Tension in the Air prints a cost");
+  const st = side(g, 0, {hand: [ta, mb], arsenal: null, res: 4, ap: 1});
+  assert.equal(J.instantFirst(st, 0, [atkOf(mb)], yes), null);
+});
+
+test("a card that prints a cost is not tried even when the pool floats enough to pay it", {skip}, () => {
+  const {g, co, mb} = setup();
+  const paid = {...co, cost: 1};
+  const st = side(g, 0, {hand: [paid, mb], arsenal: null, res: 1, ap: 1});
+  assert.equal(J.legal(st, {t: "play", uid: paid.uid, from: "hand"}, 0), null, "legal: the pool pays for it");
+  assert.equal(J.instantFirst(st, 0, [atkOf(mb)], yes), null);
+  const free = side(g, 0, {hand: [co, mb], arsenal: null, res: 1, ap: 1});
+  assert.ok(J.instantFirst(free, 0, [atkOf(mb)], yes), "the same card at its printed cost 0 is chosen");
+});
+
+test("a free card that is NOT an Instant spends the action point and is not tried", {skip}, () => {
+  const {g, mb} = setup();
+  const {c: bz} = find("Booze!");
+  assert.ok(!(+bz.cost > 0), "Booze! is free");
+  const st = side(g, 0, {hand: [bz, mb], arsenal: null, res: 0, ap: 1});
+  const before = J.effPowerNow(st, 0, mb.uid, "hand").power;
+  assert.equal(J.instantFirst(st, 0, [atkOf(mb)], yes), null);
+  assert.ok(before > 0);
+});
+
+test("it writes nothing", {skip}, () => {
+  const {mb, st} = setup();
+  const before = JSON.stringify(st);
+  J.instantFirst(st, 0, [atkOf(mb)], yes);
+  assert.equal(JSON.stringify(st), before);
+});
+
+function policy(env){
+  const {execFileSync} = require("node:child_process");
+  const prog = `
+    const {match, W} = require("./tools/selfplay.js"); const SP = require("./engine/sparring.js");
+    const g0 = match("lyath", "kayo", "if-policy", 0);
+    const pick = n => g0.sides[0].deck.find(x => x.name === n);
+    const co = pick("Concealed Object"), mb = pick("Mocking Blow"), alt = pick("Walk in My Shoes");
+    const g = {...g0, sides: g0.sides.map((s, k) => k ? s : {...s, hand: [co, mb, alt], arsenal: null, res: 0, ap: 1})};
+    const r = SP.explain(g, 0); console.log(JSON.stringify({uid: r.action.uid, key: r.key, co: co.uid, mb: mb.uid, alt: alt.uid, line: r.line || null}));`;
+  return JSON.parse(execFileSync(process.execPath, ["-e", prog],
+    {cwd: require("node:path").join(__dirname, ".."), env: {...process.env, ...env}}).toString().trim());
+}
+
+test("gate on: the rule policy plays the instant first and says why", {skip}, () => {
+  const out = policy({SPXINSTFIRST: "lyath"});
+  assert.equal(out.uid, out.co);
+  assert.equal(out.key, "instantFirst");
+});
+
+test("gate off (the default): the attack leads, as before", {skip}, () => {
+  const out = policy({SPXINSTFIRST: ""});
+  assert.notEqual(out.uid, out.co, "off: the instant waits behind the attack");
+  assert.notEqual(out.key, "instantFirst");
+  const none = policy({SPXINSTFIRST: "none"});
+  assert.deepEqual(none, out, "none is the same as unset");
+});
+
+test("a hero list names seats: another hero's seat does not take the branch", {skip}, () => {
+  const out = policy({SPXINSTFIRST: "kayo"});
+  assert.notEqual(out.key, "instantFirst");
+});
+
+test("the search seat keeps its own order: the branch is not taken when search is asked for", {skip}, () => {
+  const {execFileSync} = require("node:child_process");
+  const prog = `
+    const {match} = require("./tools/selfplay.js"); const SP = require("./engine/sparring.js");
+    const g0 = match("lyath", "kayo", "if-policy", 0);
+    const pick = n => g0.sides[0].deck.find(x => x.name === n);
+    const co = pick("Concealed Object"), mb = pick("Mocking Blow");
+    const g = {...g0, sides: g0.sides.map((s, k) => k ? s : {...s, hand: [co, mb], arsenal: null, res: 0, ap: 1})};
+    const r = SP.explain(g, 0, {search: false}), q = SP.explain(g, 0, {search: true});
+    console.log(JSON.stringify({rule: r.key, sharp: q.key}));`;
+  const out = JSON.parse(execFileSync(process.execPath, ["-e", prog],
+    {cwd: require("node:path").join(__dirname, ".."), env: {...process.env, SPXINSTFIRST: "all"}}).toString().trim());
+  assert.equal(out.rule, "instantFirst", "Steady takes it");
+  assert.notEqual(out.sharp, "instantFirst", "Sharp decides by its own search, under its own key");
+});
