diff --git a/test/overblock.test.js b/test/overblock.test.js
new file mode 100644
index 0000000..09c4d97
--- /dev/null
+++ b/test/overblock.test.js
@@ -0,0 +1,60 @@
+/* test/overblock.test.js — H-OVERBLOCK (Enigma census, v6.14): no hand blocker
+   beside a defence reaction that stops the whole leak by itself.
+
+   `nextBlocker` (the rule wall, and the search's baseline set) declined to add a
+   hand card when a defence reaction in hand or arsenal (`judge.defendsNow`) prints
+   defence covering the whole leak and its printed cost is in reach of floating
+   resources plus the free hand's pitch. Not on a lethal hit. Gate SPXOVERBLOCK,
+   call key `blockRxCovers`. Asserts on the action and the call key; each refusal
+   (short, unaffordable, lethal) is the sabotage of the match. */
+const test = require("node:test");
+const assert = require("node:assert/strict");
+const H = require("./helpers/judged.js");
+const SP = require("../engine/sparring.js");
+const P = require("../engine/priority.js");
+const J = H.J;
+const skip = !H.hasDb() && "no cached card database";
+
+/* the first block decision Enigma (seat 0) faces in a seeded game */
+function blockPoint(){
+  const {match} = require("../tools/selfplay.js");
+  let n = match("enigma", "kayo", "ob-kayo-0", 0);
+  for(let i = 0; i < 6000 && !n.over; i++){
+    if(P.canDeclareDefenders(n, 0) && n.pend && n.pend.total >= 6) return n;
+    let moved = false;
+    for(const seat of [0, 1]){ const a = SP.act(n, seat); if(!a) continue; const r = J.reduce(n, a, seat); if(r.error) continue; n = r.state; moved = true; break; }
+    if(!moved) break;
+  }
+  return null;
+}
+const mk = (nm, p, uid) => ({...H.card(nm, p), uid});
+/* a hand of a 3-defence blocker, Unmovable (printed defence 7 at pitch 1), and two blues to pay its 3 */
+function setUp(o){
+  const g = blockPoint();
+  assert.ok(g, "the fixture reaches a block decision");
+  o = o || {};
+  const um = mk("Unmovable", 1, "um1");
+  assert.ok(J.defendsNow({...g, sides: g.sides.map((sd, i) => i ? sd : {...sd, hand: [um]})}, 0, "um1", "hand"), "Unmovable is a defence reaction");
+  const hand = [mk("Test of Strength", 1, "ts1"), um].concat(o.broke ? [] : [mk("Big Blue Sky", 3, "bb1"), mk("Second Tenet of Chi: Wind", 3, "st1")]);
+  return {...g, sides: g.sides.map((sd, i) => i ? sd : {...sd, hand, arsenal: null, res: 0, blockH: [], blockG: (sd.gear || []).map(x => x.uid), hp: o.hp || 20}),
+          pend: {...g.pend, total: o.total || 6}};
+}
+const wallOf = g => SP.wallOf(g.sides[0]);
+
+test("a leak a defence reaction stops alone: no hand card is declared, and the call says why", {skip}, () => {
+  const g = setUp();
+  assert.ok(g.pend.total - wallOf(g) <= 7, "the leak is within Unmovable's printed defence");
+  assert.equal(SP.nextBlocker(g, 0, SP.DEFAULTS), null, "Test of Strength stays in hand");
+  assert.equal(SP.explain(g, 0).key, "blockRxCovers");
+});
+test("SABOTAGE — the reaction falls short, cannot be paid for, or the hit is lethal: the hand card blocks", {skip}, () => {
+  const short = setUp({total: 30});
+  const a = SP.nextBlocker(short, 0, SP.DEFAULTS);
+  assert.ok(a && a.t === "defend", "a leak past the reaction's defence: blocks — " + JSON.stringify(a));
+  const broke = setUp({broke: true});
+  const b = SP.nextBlocker(broke, 0, SP.DEFAULTS);
+  assert.ok(b && b.t === "defend" && b.uid === "ts1", "no pitch for its cost: blocks — " + JSON.stringify(b));
+  const lethal = setUp({hp: 3});
+  const c = SP.nextBlocker(lethal, 0, SP.DEFAULTS);
+  assert.ok(c && c.t === "defend", "a lethal hit: blocks — " + JSON.stringify(c));
+});
