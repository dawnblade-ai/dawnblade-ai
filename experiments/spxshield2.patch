+/* ---- THE LAST ATTACK OF THE TURN, AIMED AT AN ALLY (H-SHIELD2) ----
+   For `sparring.js`, which reads no card text. CR 7.3.2a: an attack on an ally cannot
+   be defended and its damage lands on the ally, so "the next time YOU would be dealt
+   damage this turn, prevent X" (Throw Caution to the Wind, Cloud Cover, Toe the Line)
+   waits for a LATER hit on the hero. That hit can only come while the attacker can
+   attack again: this link has go again (`pend.ga`, or a grant waiting to land on it),
+   or its controller keeps an action point after it (the point is spent at resolution,
+   so `ap` still counts it here). Measured on Gravy's casts at ally attacks (3 seeds,
+   84 games): a link with go again — 20 of 22 shields caught a later hit on Gravy; the
+   last link — 28 of 29 expired. True only for that last link. */
+const linkLastAtAlly = g => {
+  const p = g && g.pend;
+  if(!p || !p.card || GM.targetCanBeDefended(p.target)) return false;
+  if(p.ga || g._gaGrant) return false;
+  return ((at(g, p.by) || {}).ap || 0) <= 1;
+};
