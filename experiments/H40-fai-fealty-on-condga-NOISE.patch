+/* ---- A "NEXT CARD IS DRACONIC" PIECE, AND WHAT IT OPENS FOR THIS PLAY (SPXFEALTY) ----
+   For `sparring.js`, which reads no card text. Fai's Fealty token: "Instant - Destroy this: The
+   next card you play this turn is Draconic" (`dracCard`). The engine stamps the next card PLAYED
+   (`_drac`, effects' play site) and every reader asks the card, so what the stamp opens is asked
+   of the engine's own gate loop (`effects.gatesMetNow`). null when no board piece of the seat
+   prints that grant (or `legal` will not activate one), the grant is already up, the card is not
+   one the seat holds in `from`, or the stamp opens no gate; otherwise `{uid, own, chain}`: the
+   piece (uid order), how many of the card's OWN gated ops the stamp opens (Dragon Power's +3{p},
+   Art of the Dragon: Fire's "deal 2"), and how many gated ops of the seat's OTHER held attacks
+   open with this attack's link counted Draconic on the chain ("If you control 2 or more Draconic
+   chain links": Hot on Their Heels, Cinderskin Devotion, Phoenix Flame). Census (96 games):
+   Fealty legal 221 times on Fai's turns, used 0. */
+const dracGrantFor = (g, seat, uid, from) => {
+  const sd = at(g, seat);
+  if(sd.dracCard || !PR.isCardPlay(from)) return null;
+  const c = from === "arsenal" ? (sd.arsenal && sd.arsenal.uid === uid ? sd.arsenal : null)
+          : from === "hand" ? (sd.hand || []).find(x => x && x.uid === uid) : null;
+  if(!c || c._drac) return null;
+  const piece = (sd.board || []).filter(b => b && b.uid != null).slice()
+    .sort((a, b) => String(a.uid) < String(b.uid) ? -1 : String(a.uid) > String(b.uid) ? 1 : 0)
+    .find(b => { const p = BD.boardPow(b);
+      return p && (PR.fxParse(p).ops || []).some(o => o && o[0] === "dracCard")
+        && legal(g, {t: "activate", uid: b.uid}, seat) == null; });
+  if(!piece) return null;
+  const fx = effectsFor(g).fx, key = x => x.join("|");
+  const opened = (before, after) => { const b = new Set(before.map(key)); return after.filter(x => !b.has(key(x))).length; };
+  const own = opened(fx.gatesMetNow(g, seat, c, from), fx.gatesMetNow(g, seat, Object.assign({}, c, {_drac: true}), from));
+  let chain = 0;
+  if(TY.isAttack(c)){
+    const link = drac => Object.assign({}, g, {chain: (g.chain || []).concat([{n: c.name, kind: "atk", drac, by: seat}])});
+    const g0 = link(false), g1 = link(true);
+    const held = (sd.hand || []).map(x => ({x, f: "hand"})).concat(sd.arsenal ? [{x: sd.arsenal, f: "arsenal"}] : []);
+    for(const {x, f} of held) if(x && x.uid !== c.uid && TY.isAttack(x))
+      chain += opened(fx.gatesMetNow(g0, seat, x, f), fx.gatesMetNow(g1, seat, x, f));
+  }
+  return own > 0 || chain > 0 ? {uid: piece.uid, own, chain} : null;
+};
